__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.venv[0-9]*/
.env
.env.*
!.env.example
.DS_Store
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
outputs/
reports/generated/

# Official and derived market data stay outside Git. Keep only directory markers.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/curated/*
!data/curated/.gitkeep

# Large/generated analytical products and credentials. Rendered reports are generated
# research outputs: they are produced from verified run manifests and stay outside Git.
*.html
models/
artifacts/
credentials/
solver_artifacts/
*.joblib
*.pkl
*.pickle
*.onnx
*.lp
*.mps
*.sol
*.pem
*.key

# Common official-data formats. Small synthetic fixtures should use tests/fixtures
# and be force-reviewed before any exception is added.
*.parquet
*.xlsx
*.xls
*.xml

# Editor- and service-specific local session configuration. Development environment
# setup lives in scripts/bootstrap-dev-env.sh, which such tooling should call.
.claude/
CLAUDE.md
AGENT.md
.cursor/
.aider*

# Workflow evidence directories. Retrieved provider content and derived acceptance
# artifacts are produced by workflow runs and uploaded as private artifacts; they are
# never committed.
acceptance/
